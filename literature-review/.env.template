ACADEMIA_DATA_ROOT=/path/to/agent-data
S2_API_KEY=xxx
# Scopus, from https://dev.elsevier.com/apikey/manage — used by the PEMC
# publication-trend harvest. Needs Search API access (institutional keys have
# it). Add SCOPUS_INST_TOKEN=xxx only if your key requires one.
SCOPUS_API_KEY=xxx
ZOTERO_API_KEY=xxx
ZOTERO_LIBRARY_ID=12216824
ZOTERO_LIBRARY_TYPE=user
ZOTERO_LOCAL=true
MOONSHOT_API_KEY=xxx
DEEPSEEK_API_KEY=xxx
# Free from openalex.org. Without it OpenAlex allows about 100 requests a day,
# which one review can exhaust -- and an exhausted quota answers HTTP 429, which
# a reader can mistake for a literature that does not exist.
OPENALEX_API_KEY=xxx
